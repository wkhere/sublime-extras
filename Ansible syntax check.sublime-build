{
	"shell_cmd": "ansible-playbook -iinv *.yml --syntax-check",
	// note: file_regex doesn't catch the error message
	"file_regex": "^Origin: (..[^:\n]*):([0-9]+):([0-9]+)$",
	"working_dir": "${folder:${project_path:${file_path}}}",
	"selector": "source.ansible",
	"syntax": "Packages/YAML/YAML.sublime-syntax",
	"keyfiles": ["inv"],
}
